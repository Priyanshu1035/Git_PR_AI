# --- Required ---
API_KEY=change-me-long-random-string          # protects /api/* (send as x-api-key header)
GITHUB_TOKEN=github_pat_xxx                   # fine-grained PAT: Contents, Pull requests, Issues = Read & write
ANTHROPIC_API_KEY=sk-ant-xxx
ALLOWED_REPOS=your-username/your-repo         # comma-separated allowlist (owner/name). Empty = nothing allowed

# --- Webhook (optional) ---
GITHUB_WEBHOOK_SECRET=another-random-string
TRIGGER_LABEL=ai-fix                          # adding this label to an issue triggers the agent

# --- Tuning (optional) ---
PORT=3000
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_STEPS=25
MAX_TOTAL_TOKENS=500000
CONCURRENCY=1
FORK_MODE=auto                               # auto = fork only when the token lacks push access | always | never
REQUIRE_GREEN_TESTS=true                      # false = still open a draft PR when tests fail (clearly flagged)
# INSTALL_COMMAND=npm ci --ignore-scripts
# TEST_COMMAND=npm test
COMMAND_TIMEOUT_MS=300000

# --- Failproof AI observability (optional) ---
# FAILPROOFAI_ENABLED=true                    # emit run traces via @failproofai/sdk (needs the Failproof daemon running)
# FAILPROOFAI_ENVIRONMENT=dev                 # label on every event, e.g. production. No commas.
# FAILPROOFAI_CAPTURE_CONTENT=false           # true = also record prompts, model replies and full tool I/O

# --- Sandbox (strongly recommended) ---
# SANDBOX_DOCKER_IMAGE=node:20-bookworm       # run install/tests inside Docker instead of on the host
# SANDBOX_DOCKER_NETWORK=bridge               # 'none' blocks network but breaks dependency installs
